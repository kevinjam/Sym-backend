{
  "name": "sym-backend",
  "version": "1.0.0",
  "description": "Backend API for SYM Medication Management App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "swagger": "swagger-jsdoc -d swaggerDef.js -o swagger.json",
    "clear-db": "node utils/clearDatabase.js",
    "seed-categories": "node utils/seedCategoriesAndDosageForms.js",
    "create-test-patient": "node utils/createTestPatientAndPrescription.js",
    "create-prescription": "node utils/createPrescriptionForExistingPatient.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "medication",
    "health",
    "api",
    "nodejs",
    "express"
  ],
  "author": "SYM Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "cron": "^4.3.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "firebase-admin": "^11.10.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.2",
    "stripe": "^22.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
