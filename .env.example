# Copy to .env (local) or set GitHub secret BACKEND_ENV for production deploy.
PORT=9000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sym_db?retryWrites=true&w=majority

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

APPLE_BUNDLE_ID=com.thinkdevs.sym
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=certs/apple/SubscriptionKey_XXXXX.p8
APPLE_ROOT_CERTS_DIR=certs/apple

CLINIC_SOURCE=database
