# Server Configuration
PORT=9000
NODE_ENV=development

# MongoDB Configuration (paste from Atlas → Connect → Drivers; must match an active cluster)
# If you see querySrv ENOTFOUND, the cluster host in the URI is wrong or gone — do not guess; copy a fresh URI.
# Optional: use the standard mongodb://… string (not mongodb+srv) if corporate DNS blocks SRV records.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sym_medication_app?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Access token lifetime (short)
JWT_EXPIRES_IN=30m
# Refresh token signing secret (must differ from JWT_SECRET in production)
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production
# Refresh token lifetime (long)
REFRESH_TOKEN_EXPIRES_IN=30d

# Firebase Configuration (for push notifications and Google authentication)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email



# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
# Production should include the public sites that call the API from a browser.
# Native iOS/Android apps do not use CORS.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080,http://api.symhealth-ai.com,https://api.symhealth-ai.com,http://www.symhealth-ai.com,https://www.symhealth-ai.com

# Keep-alive ping URL (cron every 14 min). Use the public API host in production.
# API_URL=https://api.symhealth-ai.com/api/health
API_URL=http://127.0.0.1:9000/api/health

# API Keys (for medication data)
OPENFDA_API_KEY=your-openfda-api-key
RXNORM_API_KEY=your-rxnorm-api-key

# AI Scanner Configuration
# OPENROUTER_API_KEY also powers Calorie Scan scene gate (non-food / wrong-mode photos)
# and plate vision estimates. Optional: CALORIE_SCAN_GATE_MODEL / CALORIE_SCAN_VISION_MODEL
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-api-key

# AI Health Reports Configuration
# Use models listed on https://openrouter.ai/models — free IDs change often.
# Optional: OPENROUTER_API_URL (default https://openrouter.ai/api/v1/chat/completions)
# Optional: OPENROUTER_APP_TITLE (sent as X-Title)
AI_HEALTH_MODEL=openrouter/free
AI_HEALTH_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_HEALTH_MAX_RETRIES=2
AI_HEALTH_TIMEOUT_MS=120000
AI_HEALTH_MAX_TOKENS=2000
AI_HEALTH_TEST_MODE=false

# AI Adherence Insights Configuration
AI_ADHERENCE_INSIGHTS=false
AI_ADHERENCE_TEST_MODE=true 

# Clinics/Providers Data Sources
# internal | npi | saintalphonsus | betterdoctor (planned)
CLINIC_SOURCE=internal
PROVIDER_SOURCE=npi

# Must match Stripe iOS/Android SDK ephemeral-key version (NOT Node stripe's
# latest API). iOS StripeCore 24.7 uses 2020-08-27. A newer version makes
# in-app PaymentSheet hang on "Preparing secure checkout…".
# STRIPE_MOBILE_API_VERSION=2020-08-27

# Stripe Checkout (server-side — secret key never goes in the mobile app)
# Docs: backend/docs/STRIPE_CHECKOUT.md
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ENTITLEMENT_ID=premium
STRIPE_TRIAL_DAYS=14
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_LITE=price_...
STRIPE_ANNUAL_PRICE_DISPLAY=$59.99
STRIPE_MONTHLY_PRICE_DISPLAY=$14.99
STRIPE_LITE_PRICE_DISPLAY=$47.99
STRIPE_SUCCESS_URL=symwellness://subscription/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=symwellness://subscription/cancel
STRIPE_PORTAL_RETURN_URL=symwellness://subscription/portal-return

# Google Places API (removed - requires paid Google Cloud account)

# FatSecret Platform API (https://platform.fatsecret.com/)
# Server-side only. Checklist for Calorie Scan photo recognition:
# 1) Register this server's PUBLIC IP under FatSecret → Manage Keys (CIDR ok on Premier).
# 2) Leave FATSECRET_SCOPE unset (OAuth returns all scopes the key actually has).
# 3) Activate Image Recognition add-on or its 14-day trial in the FatSecret dashboard.
#    IR is NOT included in Basic / Premier Free by default (optional billed add-on).
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret
# FATSECRET_SCOPE=basic
FATSECRET_REGION=US
FATSECRET_LANGUAGE=en

# OpenRouter vision (free multimodal — Gemma 4 / Nemotron VL)
# OPENROUTER_VISION_MODEL=openrouter/free
# CALORIE_SCAN_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# CALORIE_SCAN_GATE_MODEL=google/gemma-4-26b-a4b-it:free
# FATSECRET_IMAGE_RECOGNITION=false
# CALORIE_SCAN_ALLOW_PAID_VISION=false
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Saint Alphonsus scraper (if CLINIC_SOURCE=saintalphonsus)
SA_LOCATIONS_URL=https://www.saintalphonsus.org/locations
# TTL for scraper cache in ms (default 24h)
SA_TTL_MS=86400000
# ---- Apple App Store / Google Play billing (in-app purchases) ----
# Store product IDs: the subscription product IDs created in App Store Connect
# and Google Play Console. Leave blank until they exist.
APPLE_PRODUCT_MONTHLY=
APPLE_PRODUCT_ANNUAL=
APPLE_PRODUCT_LITE=
GOOGLE_PRODUCT_MONTHLY=
GOOGLE_PRODUCT_ANNUAL=
GOOGLE_PRODUCT_LITE=

# Apple (App Store Server API + Server Notifications V2)
APPLE_BUNDLE_ID=com.thinkdevs.sym
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# The .p8 contents with newlines escaped as \n, or a path to the file:
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=
# Apple's root CA certificates (.cer) are read from certs/apple by default.
# Only set this to use a different folder (absolute, or relative to the backend root).
# APPLE_ROOT_CERTS_DIR=

# Google Play (Play Developer API + real-time developer notifications)
GOOGLE_PLAY_PACKAGE_NAME=com.thinkdevs.sym
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
# Shared secret appended as ?token= on the Pub/Sub push endpoint
GOOGLE_RTDN_TOKEN=
