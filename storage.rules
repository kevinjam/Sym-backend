rules_version = '2';

// Firebase Storage rules for SymWellness profile photos.
// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos are uploaded by the backend (Admin SDK).
    // Public read so the mobile app can display them without auth tokens.
    match /profile-pictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
